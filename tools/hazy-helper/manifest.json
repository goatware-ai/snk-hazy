{
  "manifest_version": 3,
  "name": "Hazy Helper",
  "version": "1.0.0",
  "description": "Fill the task submission form from a task package: domain and occupation, instruction, file lists, times, tools and the rubric. Never touches file uploads.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Hazy Helper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
