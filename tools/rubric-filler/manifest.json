{
  "manifest_version": 3,
  "name": "Rubric Filler",
  "version": "1.4.0",
  "description": "Fill the platform's rubric criterion form from a CSV, compare the form against it, and export it back out as CSV",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Rubric Filler",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
